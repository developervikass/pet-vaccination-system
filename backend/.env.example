# MySQL is the required database backend for this project.
DB_ENGINE=mysql

# Django secret key (must be at least 32 characters). Replace with your own
# random string in production.
SECRET_KEY=dev-secret-key-please-change-this-to-a-long-random-value-32chars+

# MySQL settings (used only when DB_ENGINE=mysql)
DB_NAME=pet_vaccination_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Email settings (optional override)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=app_password
